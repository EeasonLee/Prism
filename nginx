server {
    listen 80;
    listen 443 ssl http2;
    server_name www.joydeem.com;

    # ===== Magento 基础配置 =====
    index index.php index.html index.htm;

    set $MAGE_ROOT /www/webapp/joydeem.com/public_html;
    set $MAGE_MODE developer;
    set $MAGE_RUN_TYPE store;

    # ===== SSL 配置 =====
    ssl_certificate     /www/server/panel/vhost/cert/joydeem.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/joydeem.com/privkey.pem;
    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+CHACHA20-draft:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:EECDH+3DES:RSA+3DES:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_tickets on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000";
    error_page 497 https://$host$request_uri;

    keepalive_timeout 300s;

    # ===== SSL 证书申请验证 =====
    include /www/server/panel/vhost/nginx/well-known/joydeem.com.conf;

    location ~ \.well-known {
        allow all;
    }

    if ($uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$") {
        return 403;
    }

    # ===== 禁止访问敏感文件 =====
    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README.md) {
        return 404;
    }

    # ============================================
    # 🛒 Magento 路径（走 PHP）
    # ============================================

    # hrmanager2025
    location ^~ /hrmanager2025/ {
        try_files $uri $uri/ /index.php?$args;
    }
    # 购物车 / 结账
    location ^~ /checkout/ {
        try_files $uri $uri/ /index.php?$args;
    }
    location ^~ /sso/ {
        try_files $uri $uri/ /index.php?$args;
    }
    location ^~ /stripe/ {
        try_files $uri $uri/ /index.php?$args;
    }
    location ^~ /amasty_promo/ {
        try_files $uri $uri/ /index.php?$args;
    }

    location ^~ /onepagecheckout/ {
        try_files $uri $uri/ /index.php?$args;
    }
    location ^~ /giftcard/ {
        try_files $uri $uri/ /index.php?$args;
    }


    # 订单
    location ^~ /sales/ {
        try_files $uri $uri/ /index.php?$args;
    }

    # PayPal
    location ^~ /paypal/ {
        try_files $uri $uri/ /index.php?$args;
    }

    # Express Checkout
    location = /expresscheckout.html {
        try_files $uri /index.php?$args;
    }

    # Magento REST API
    location ^~ /rest/ {
        try_files $uri $uri/ /index.php?$args;
    }

    # Magento GraphQL
    location = /graphql {
        try_files $uri /index.php?$args;
    }

    # ============================================
    # 📦 Magento 静态资源
    # ============================================

    # /static/ - Magento 静态文件
    location /static/ {
        root $MAGE_ROOT/pub;

        location ~* ^/static/version\d* {
            rewrite ^/static/version\d*/(.*)$ /static/$1 last;
        }

        location ~* \.(ico|jpg|jpeg|png|gif|svg|webp|js|css|swf|eot|ttf|otf|woff|woff2|html|json)$ {
            add_header Cache-Control "public";
            add_header X-Frame-Options "SAMEORIGIN";
            expires +1y;
            try_files $uri $uri/ /static.php?resource=$uri&last;
        }

        location ~* \.(zip|gz|gzip|bz2|csv|xml)$ {
            add_header Cache-Control "no-store";
            add_header X-Frame-Options "SAMEORIGIN";
            expires off;
            try_files $uri $uri/ /static.php?resource=$uri&last;
        }

        if (!-f $request_filename) {
            rewrite ^/static/(version\d*/)?(.*)$ /static.php?resource=$2 last;
        }

        add_header X-Frame-Options "SAMEORIGIN";
    }

    # /media/ - Magento 媒体文件
    location /media/ {
        root $MAGE_ROOT/pub;

        try_files $uri $uri/ /get.php$is_args$args;

        location ~ ^/media/theme_customization/.*\.xml {
            deny all;
        }

        location ~* \.(ico|jpg|jpeg|png|gif|svg|webp|js|css|swf|eot|ttf|otf|woff|woff2)$ {
            add_header Cache-Control "public";
            add_header X-Frame-Options "SAMEORIGIN";
            expires +1y;
            try_files $uri $uri/ /get.php$is_args$args;
        }

        add_header X-Frame-Options "SAMEORIGIN";
    }

    # 禁止访问敏感目录
    location /media/customer/    { deny all; }
    location /media/downloadable/ { deny all; }
    location /media/import/      { deny all; }

    # /pub/ 路径（兼容直接访问）
    location /pub/ {
        root $MAGE_ROOT;
        try_files $uri $uri/ /index.php?$args;
    }

    # /errors/ 错误页（Magento 自带）
    location /errors/ {
        root $MAGE_ROOT/pub;
        try_files $uri $uri/ /index.php?$args;
    }
    
   location ~ ^/customer/account/login/?$ {
    return 301 https://www.joydeem.com/login$is_args$args;
}

# register
location ~ ^/customer/account/create/?$ {
    return 301 https://www.joydeem.com/login$is_args$args;
}

location /checkout/account/delegateCreate/ {
    return 301 https://www.joydeem.com/login$is_args$args;
}



location /customer/ {
    root $MAGE_ROOT/pub;
    try_files $uri $uri/ /index.php?$args;
}

 

    # ============================================
    # 🌐 其他所有页面 → next.js (3090)
    # ============================================
    location / {
        proxy_pass http://44.226.192.149:3091;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 600;
        proxy_send_timeout 600;
        proxy_read_timeout 600;
        send_timeout 600;
    }

    # ============================================
    # 🐘 PHP 处理（Magento 入口）
    # ============================================
    location ~ ^/(index|get|static|errors/report|errors/404|errors/503|health_check)\.php$ {
        try_files $uri =404;

        fastcgi_pass unix:/tmp/php-cgi-81.sock;   # ⚠️ 根据你实际 PHP-FPM 路径调整
        fastcgi_buffers 1024 4k;
        fastcgi_param  PHP_FLAG  "session.auto_start=off \n suhosin.session.cryptua=off";
        fastcgi_param  PHP_VALUE "memory_limit=2048M \n max_execution_time=18000";
        fastcgi_read_timeout 600s;
        fastcgi_connect_timeout 600s;
        fastcgi_param MAGE_MODE $MAGE_MODE;
        fastcgi_param MAGE_RUN_TYPE $MAGE_RUN_TYPE;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # 拒绝直接访问其他 .php 文件
    location ~ \.php$ {
        return 404;
    }

    # ============================================
    # 日志
    # ============================================
    access_log /www/wwwlogs/joydeem.com.log;
    error_log  /www/wwwlogs/joydeem.com.error.log;

    # 配置 root（让静态文件能直接读到）
    root $MAGE_ROOT/pub;
}


