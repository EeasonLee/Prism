{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "baseUrl": ".",
    "paths": {
      "@/app/*": ["./app/*"],
      "@/infrastructure/*": ["./infrastructure/*"],
      "@/ui/*": ["./ui/*"],
      "@/features/*": ["./features/*"],
      "@/*": ["./*"],
      "@prism/shared": ["../../libs/shared/src/index.ts"],
      "@prism/shared/*": ["../../libs/shared/*"]
    },
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "next",
      "next/image-types/global"
    ],
    "allowJs": true,
    "incremental": true,
    "noEmit": true
  },
  "exclude": [
    "out-tsc",
    "dist",
    "tailwind.config.js",
    "postcss.config.js",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "references": [
    {
      "path": "../../libs/shared/tsconfig.lib.json"
    }
  ]
}
