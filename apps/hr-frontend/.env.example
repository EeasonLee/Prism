# ============================================
# Huaren Store (hr-frontend) 环境变量示例
# ============================================
# 复制为 .env.local 后按需填写

# 应用地址（开发端口 3093）
NEXT_PUBLIC_APP_URL=http://localhost:3093

# Strapi / Magento / Meilisearch — 与 jd-frontend 共用同一套后端时可复用相同配置
# STRAPI_URL=http://127.0.0.1:1338
# MAGENTO_URL=https://www.huarenstore.com
# MAGENTO_STORE_CODE=default
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_INDEX_PREFIX=huarenstore

NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_USE_API_PROXY=false

# 本地开发若暂未配置 AUTH_TOKEN_SECRET，可临时跳过校验
SKIP_AUTH_TOKEN_SECRET_VALIDATION=1
# AUTH_TOKEN_SECRET=your-secret
