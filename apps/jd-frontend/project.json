{
  "name": "jd-frontend",
  "root": "apps/jd-frontend",
  "projectType": "application",
  "sourceRoot": "apps/jd-frontend/app",
  "tags": ["type:app", "scope:frontend"],
  "targets": {
    "print-build-info": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/print-build-info.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "dev": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "jd-frontend:build",
        "port": 3090,
        "dev": true,
        "hostname": "0.0.0.0"
      },
      "dependsOn": ["print-build-info"]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/jd-frontend",
        "{workspaceRoot}/apps/jd-frontend/.next"
      ],
      "dependsOn": ["print-build-info"],
      "options": {
        "parallel": false,
        "cwd": "{workspaceRoot}",
        "commands": [
          "nx run jd-frontend:next-build",
          "node apps/jd-frontend/scripts/sync-standalone-assets.mjs"
        ]
      }
    },
    "next-build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/jd-frontend"
      }
    },
    "start": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "jd-frontend:build",
        "port": 3002,
        "dev": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/jd-frontend/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": false,
        "config": "apps/jd-frontend/vite.config.ts",
        "reportsDirectory": "apps/jd-frontend/test-output/vitest"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "options": {
        "config": "apps/jd-frontend/playwright.config.js",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "apps/jd-frontend/app/page.tsx",
        "tsConfig": "apps/jd-frontend/tsconfig.json",
        "outputPath": "dist/apps/jd-frontend"
      }
    }
  }
}
