# ============================================
# Prism 应用环境变量配置示例
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 仅填写当前环境真正需要的值
# 3. .env.local 不要提交到版本控制
#
# 说明：
# - 本文件只列“代码里真实读取”的变量
# - 某些变量是可选的，但一旦启用对应功能就必须配置
# - 客户端变量（NEXT_PUBLIC_*）会暴露到浏览器，不能放密钥
# ============================================

# ============================================
# 客户端环境变量（NEXT_PUBLIC_*）
# ============================================

# 应用基础地址
# 用途：metadata / canonical / Open Graph / redirect URL 生成
# 要求：必须是完整 URL，且与本地实际启动端口一致
# 本地示例：http://localhost:3010
NEXT_PUBLIC_APP_URL=http://test1.joydeem.com

# 通用内容 API 基础地址（可选）
# 用途：部分内容请求的默认基础地址
# 要求：
# - 可以留空
# - 若填写，可以是绝对地址（http://localhost:1337）
# - 或相对前缀（例如 /api-proxy）
# - 不要带尾部 /
NEXT_PUBLIC_API_URL=http://test1.joydeem.com

# 图片基础地址（可选）
# 用途：当图片字段返回相对路径时，作为优先拼接前缀
# 要求：完整 URL，不要带尾部 /
# 不填时，代码会按环境 fallback
NEXT_PUBLIC_IMAGE_BASE_URL=https://d2s2mafqv46idp.cloudfront.net/joydeem

# 日志级别
# 可选值：debug | info | warn | error
NEXT_PUBLIC_LOG_LEVEL=debug

# 是否启用 Next.js API 代理
# true 时，浏览器端请求会优先走同源代理，减少开发期 CORS 问题
NEXT_PUBLIC_USE_API_PROXY=true

# 说明：NEXT_PUBLIC_APP_VERSION 由 next.config.js 在构建时自动注入
# 无需手动配置

# ============================================
# 服务端环境变量
# ============================================
# 这些变量只在 Next.js 服务端可用，不会暴露到浏览器
# （个别变量如 REQUIRE_LOGIN_FOR_CHECKOUT 会在 next.config.js 中显式注入客户端）

# Node 运行环境
# 一般无需手动设置，Next.js 会自动注入
# NODE_ENV=development

# Strapi 对外访问地址（可选，但内容/媒体场景强烈建议配置）
# 用途：媒体 URL 拼接、服务端内容请求
# 要求：完整 URL，不要带 /api，不要带尾部 /
STRAPI_URL=http://127.0.0.1:1338

# Strapi 服务端访问 Token（可选）
# 用途：服务端请求 Strapi 的受保护接口
STRAPI_API_TOKEN=5c3bb3...1a7b

# Strapi 服务端内部地址（推荐）
# 用途：Server Component / Route Handler 在服务端直接访问 Strapi
# 当“浏览器可访问地址”和“Node 服务端可访问地址”不同的时候必须设置
# STRAPI_INTERNAL_URL=http://localhost:1337

# Magento 站点基础地址（推荐）
# 用途：REST/GraphQL 的主机来源（REST 会拼接 /rest/{storeCode}/V1）
# 要求：完整 URL，不要带尾部 /
# 示例（joydeem 线上）：https://www.joydeem.com
MAGENTO_URL=https://www.joydeem.com

# Magento REST store code（用于 /rest/{storeCode}/V1）
# 例如 joydeem 线上常用 en；未配置时默认 default
# 当出现 /rest/default/V1 404/400 时，优先检查这里是否与站点 store code 一致
MAGENTO_STORE_CODE=en

# 是否要求游客先登录再 checkout
# true：游客点击 checkout 时弹登录
# false / 不填：允许游客直接尝试 checkout（最终是否允许仍取决于上游）
# 说明：该变量通过 next.config.js 注入客户端，因此客户端组件也能读取
REQUIRE_LOGIN_FOR_CHECKOUT=false

# Revalidate 鉴权密钥（按需配置）
# 用途：/api/revalidate 以及部分 admin route 的鉴权
# 若不配置，相关 revalidate / 管理接口会不可用或直接报错
REVALIDATE_SECRET=0d682b...a6de

# 管理接口专用密钥（可选）
# 用途：/api/admin/catalog-inspect 和 /api/admin/sync/magento-to-strapi
# 若不配置，会回退使用 REVALIDATE_SECRET
# ADMIN_SECRET=***

# Meilisearch 服务端 API Key（可选）
# 用途：服务端调用 Meilisearch 时附带认证
# 若 Meilisearch 未开启认证，可不填
MEILISEARCH_API_KEY=dev_me..._key

# Meilisearch 服务地址（服务端专用）
MEILISEARCH_HOST=http://127.0.0.1:7700

# Meilisearch 商品索引前缀（代码会拼接 _product_<store_code>）
MEILISEARCH_INDEX_PREFIX=joydeem

# 可用于覆盖动态索引名（如 joydeem_product_en）
# MEILISEARCH_INDEX_NAME=joydeem_product_en

# Discord Webhook 告警地址（可选）
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/1495276728069918870/mWlnVVS67baSBpYkpgu6RnXYetrO2dgnsjcavEE2hsH8ij-pr8fBDqOoqFRs3fwOtcfX

# 认证 Token 签名密钥（按需配置）
# 用途：本地封装 session token
AUTH_TOKEN_SECRET=quhhgs...f1eh

# Magento redirect token 签名密钥（按需配置）
# 用途：购物车/结账跳转到 Magento 时生成 redirect JWT
# 若相关跳转能力启用，则必须配置
MAGENTO_JWT_SECRET=ca9cb2...81d5
