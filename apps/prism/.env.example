# ============================================
# Prism 应用环境变量配置示例
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 仅填写当前环境真正需要的值
# 3. .env.local 不要提交到版本控制
#
# 说明：
# - 本文件只列“代码里真实读取”的变量
# - 某些变量是可选的，但一旦启用对应功能就必须配置
# - 客户端变量（NEXT_PUBLIC_*）会暴露到浏览器，不能放密钥
# ============================================

# ============================================
# 客户端环境变量（NEXT_PUBLIC_*）
# ============================================

# 应用基础地址
# 用途：metadata / canonical / Open Graph / redirect URL 生成
# 要求：必须是完整 URL，且与本地实际启动端口一致
# 本地示例：http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3010

# 通用内容 API 基础地址（可选）
# 用途：部分内容请求的默认基础地址
# 要求：
# - 可以留空
# - 若填写，可以是绝对地址（http://localhost:1337）
# - 或相对前缀（例如 /api-proxy）
# - 不要带尾部 /
NEXT_PUBLIC_API_URL=

# Strapi 对外访问地址（可选，但内容/媒体场景强烈建议配置）
# 用途：浏览器侧内容请求、媒体 URL 拼接、reviews 媒体展示
# 要求：完整 URL，不要带 /api，不要带尾部 /
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# 图片基础地址（可选）
# 用途：当图片字段返回相对路径时，作为优先拼接前缀
# 要求：完整 URL，不要带尾部 /
# 不填时，代码会按环境 fallback
# NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:1337

# 日志级别
# 可选值：debug | info | warn | error
NEXT_PUBLIC_LOG_LEVEL=debug

# 是否启用 Next.js API 代理
# true 时，浏览器端请求会优先走同源代理，减少开发期 CORS 问题
NEXT_PUBLIC_USE_API_PROXY=true

# 是否要求游客先登录再 checkout
# true：游客点击 checkout 时弹登录
# false / 不填：允许游客直接尝试 checkout（最终是否允许仍取决于上游）
NEXT_PUBLIC_REQUIRE_LOGIN_FOR_CHECKOUT=true

# Magento / SSO REST 服务地址
# 用途：BFF / Magento 服务端代理的上游地址
# 要求：完整 URL，不要带尾部 /
NEXT_PUBLIC_MAGENTO_API_URL=http://192.168.50.4:13000

# Magento GraphQL 地址
# 用途：商品目录、分类、详情等 GraphQL 读取
# 要求：完整 URL，通常以 /graphql 结尾
NEXT_PUBLIC_MAGENTO_GRAPHQL_URL=https://192.168.50.4/graphql

# 兼容旧配置名（可选，不推荐新环境继续使用）
# 仅当历史代码或旧部署仍依赖它时再配置
# NEXT_PUBLIC_MAGENTOL=http://192.168.50.4

# Meilisearch 对外地址（可选）
# 用途：商品搜索 / discovery 检索
# 不启用 discovery 时可不填；启用后建议同时配置服务端 API Key
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700

# 说明：NEXT_PUBLIC_APP_VERSION 由 next.config.js 在构建时自动注入
# 无需手动配置

# ============================================
# 服务端环境变量
# ============================================
# 这些变量只在 Next.js 服务端可用，不会暴露到浏览器

# Node 运行环境
# 一般无需手动设置，Next.js 会自动注入
# NODE_ENV=development

# Strapi 服务端访问 Token（可选）
# 用途：服务端请求 Strapi 的受保护接口
# STRAPI_API_TOKEN=your_strapi_api_token_here

# Strapi 服务端内部地址（推荐）
# 用途：Server Component / Route Handler 在服务端直接访问 Strapi
# 当“浏览器可访问地址”和“Node 服务端可访问地址”不同的时候必须设置
STRAPI_INTERNAL_URL=http://localhost:1337

# Revalidate 鉴权密钥（按需配置）
# 用途：/api/revalidate 以及部分 admin route 的鉴权
# 若不配置，相关 revalidate / 管理接口会不可用或直接报错
# REVALIDATE_SECRET=replace_with_revalidate_secret

# 管理接口专用密钥（可选）
# 用途：/api/admin/catalog-inspect 和 /api/admin/sync/magento-to-strapi
# 若不配置，会回退使用 REVALIDATE_SECRET
# ADMIN_SECRET=replace_with_admin_secret

# Meilisearch 服务端 API Key（可选）
# 用途：服务端调用 Meilisearch 时附带认证
# 若 Meilisearch 未开启认证，可不填
# MEILISEARCH_API_KEY=replace_with_meilisearch_api_key

# 本地认证模式
# true：使用本地封装 session token，适合本地开发稳定 guest/customer 会话
# false / 不填：直接依赖上游 auth 行为
USE_LOCAL_AUTH=true

# 当 USE_LOCAL_AUTH=true 时必须配置下面两个密钥
# 建议使用足够长的随机字符串
AUTH_TOKEN_SECRET=replace-with-local-auth-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-local-refresh-secret

# Magento redirect token 签名密钥（按需配置）
# 用途：购物车/结账跳转到 Magento 时生成 redirect JWT
# 若相关跳转能力启用，则必须配置
# MAGENTO_JWT_SECRET=replace_with_magento_jwt_secret

# 本地自签名证书调试（按需配置）
# 某些内网 https 服务证书不受信任时，可在开发环境设为 0
# 生产环境不要开启
# NODE_TLS_REJECT_UNAUTHORIZED=0
